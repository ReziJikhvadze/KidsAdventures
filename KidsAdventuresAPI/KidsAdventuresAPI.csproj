<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- API-only deploy: frontend is a separate App Service (adventuresfront) -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Set true to skip npm build + frontend-deploy.zip during Publish -->
    <SkipFrontendBuild>false</SkipFrontendBuild>
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\**;frontend-dist\**;frontend-deploy.zip</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.22" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.22" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.18" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="QuestPDF" Version="2025.7.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Stripe.net" Version="49.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\Scripts\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\Scripts\README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Scripts\Manual\**\*" CopyToOutputDirectory="Never" />
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Drop stale static web asset manifests (VS can cache old wwwroot/azure-ssr paths). -->
  <Target Name="CleanStaleStaticWebAssets" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(BaseIntermediateOutputPath)staticwebassets" Condition="Exists('$(BaseIntermediateOutputPath)staticwebassets')" />
  </Target>

  <!-- After API publish: build frontend + write frontend-deploy.zip for adventuresfront. -->
  <Target Name="BuildFrontendForDeployZip" AfterTargets="Publish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Message Importance="high" Text="Building frontend (reads wwwroot/.env.production for VITE_API_BASE_URL)..." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\wwwroot" Command="npm install" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\node_modules')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\wwwroot" Command="cmd /c &quot;npm run build&quot;" />
    <Message Importance="high" Text="Creating frontend-deploy.zip for adventuresfront..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\package-frontend-zip.ps1&quot;" />
  </Target>

</Project>
