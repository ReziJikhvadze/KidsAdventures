<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- API-only deploy: frontend is a separate App Service (adventuresfront) -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Set true to skip npm build + frontend-deploy.zip during Publish -->
    <SkipFrontendBuild>false</SkipFrontendBuild>
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\**;frontend-dist\**;frontend-deploy.zip;_build_check\**;publish\**;publish2\**;publish-test\**;publish-test2\**;publish-verify\**</DefaultItemExcludes>
    <UserSecretsId>e7b3905a-1017-4947-afaa-6235366c1e29</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.22" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.22" />
    <!-- Draft 2020-12 validation for the supplied BEKI contract schemas. They are evaluated
         verbatim rather than re-expressed in C#, and they use $ref, prefixItems, allOf and
         additionalProperties:false — a hand-rolled checker would be a second, drifting copy
         of a document the illustration pipeline's supplier owns. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.18" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.4" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Stripe.net" Version="49.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\Scripts\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\Scripts\README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Scripts\Manual\**\*" CopyToOutputDirectory="Never" />
    <!-- Both outline formats: a face bought as .otf and dropped in here would otherwise be
         left out of the publish silently, and the only symptom would be a PDF set in the
         wrong font. -->
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*.otf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Beki prompt system: the .md files are the system prompts themselves, loaded at
         runtime rather than pasted into C#, so a prompt revision is a content change and
         its version can be recorded against every generated story. -->
    <Content Include="Prompts\Beki\*.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sent to the model as the response format. The prompts name these files; without
         shipping them the model has to guess the shape and silently drops fields.
         Update, not Include: the SDK already picks up .json as Content by default. -->
    <Content Update="Prompts\Beki\schemas\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Beki\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BekiComposite\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets\BekiComposite\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The evaluation-only Ottia is not allowed to exist in the font folder, and this is the check
    that runs before anything is packaged rather than after somebody prints it. It shipped once,
    in a sold book, alongside the licensed build; the runtime registry refuses it too
    (BekiLayoutAssets.ForbiddenFontFiles), and a licence breach is worth failing twice over.
  -->
  <Target Name="RefuseTrialFonts" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <TrialFonts Include="Assets\Fonts\*Trial*" />
    </ItemGroup>
    <Error Condition="'@(TrialFonts)' != ''"
           Text="Evaluation-only font file(s) in Assets/Fonts: @(TrialFonts). The licensed Ottia-v01-Regular is the only build that may ship." />
  </Target>

  <!-- Drop stale static web asset manifests (VS can cache old wwwroot/azure-ssr paths). -->
  <Target Name="CleanStaleStaticWebAssets" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(BaseIntermediateOutputPath)staticwebassets" Condition="Exists('$(BaseIntermediateOutputPath)staticwebassets')" />
  </Target>

  <!-- After API publish: build frontend + write frontend-deploy.zip for adventuresfront. -->
  <Target Name="BuildFrontendForDeployZip" AfterTargets="Publish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Message Importance="high" Text="Building frontend (reads wwwroot/.env.production for VITE_API_BASE_URL)..." />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\frontend-dist" Condition="Exists('$(MSBuildProjectDirectory)\frontend-dist')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\wwwroot" Command="npm install" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\node_modules')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\wwwroot" Command="cmd /c &quot;npm run build&quot;" />
    <Message Importance="high" Text="Creating frontend-deploy.zip for adventuresfront..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\package-frontend-zip.ps1&quot;" />
  </Target>

  <ItemGroup>
    <!-- The prompt builders are internal, and the tests need to assert on what they produce.
         Exposing them to the test assembly is preferable to widening their visibility. -->
    <InternalsVisibleTo Include="Adventrya.Story.Tests" />
  </ItemGroup>

</Project>
