{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "adventrya-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "wwwroot",
      "port": 8080
    },
    {
      "name": "adventrya-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--launch-profile", "Production", "--no-launch-browser"],
      "cwd": ".",
      "port": 5000,
      "url": "http://localhost:5000"
    },
    {
      "name": "adventrya-api-local",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--launch-profile",
        "Development",
        "--",
        "--ConnectionStrings:DefaultConnection=Server=(localdb)\\MSSQLLocalDB;Database=KidsAdventuresLocal;Trusted_Connection=True;TrustServerCertificate=True",
        "--Providers:Story=OpenAI",
        "--LocalBlobStorage:Enabled=true"
      ],
      "cwd": ".",
      "port": 5000,
      "url": "http://localhost:5000"
    }
  ]
}
