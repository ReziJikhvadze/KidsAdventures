{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:adventuresapi-server.database.windows.net,1433;Initial Catalog=adventuresapi-database;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Issuer": "AdventurePacks.Api",
    "Audience": "AdventurePacks.Client",
    "SecretKey": "REPLACE_WITH_STRONG_64_CHAR_SECRET_KEY",
    "ExpirationMinutes": 120
  },
  "OpenAI": {
    "ApiKey": "REPLACE_WITH_OPENAI_API_KEY",
    "Model": "gpt-4.1-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "ImageGenerationProvider": "responses",
    "ImageModel": "gpt-image-1.5",
    "ImageEditModel": "gpt-image-1.5",
    "ImageSize": "1024x1024",
    "ImageQuality": "medium",
    "ImagePhotoQuality": "medium",
    "EnableStoryImages": true,
    "IllustrationPacingSeconds": 5,
    "IllustrationMaxParallel": 2,
    "IllustrationStaggerSeconds": 2
  },
  "AzureBlobStorage": {
    "ConnectionString": "REPLACE_WITH_AZURE_STORAGE_CONNECTION_STRING",
    "ContainerName": "adventurepacks"
  },
  "RateLimiting": {
    "PermitLimitPerMinute": 500,
    "DisableForLocalhost": false
  },
  "Frontend": {
    "EnableHostedNode": false,
    "NodePort": 3099,
    "OutputRelativePath": "wwwroot/azure-ssr"
  },
  "Cors": {
    "AllowLocalhostFallback": false,
    "AllowedOrigins": [
      "https://YOUR-API.azurewebsites.net"
    ]
  },
  "Email": {
    "Enabled": true,
    "FromAddress": "rezijikhvadze@gmail.com",
    "FromName": "Adventrya Books",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "rezijikhvadze@gmail.com",
    "SmtpPassword": "YOUR_GMAIL_APP_PASSWORD_16_CHARS_NOT_YOUR_NORMAL_PASSWORD",
    "BaseUrl": "https://YOUR-API.azurewebsites.net",
    "ApiBaseUrl": "https://YOUR-API.azurewebsites.net"
  },
  "GoogleAuth": {
    "Enabled": false,
    "ClientId": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
  },
  "PasswordlessAuth": {
    "Enabled": true,
    "OtpLength": 6,
    "OtpLifetimeMinutes": 10,
    "MagicLinkLifetimeMinutes": 20,
    "MaxVerifyAttempts": 5,
    "ResendCooldownSeconds": 45,
    "MaxRequestsPerDestinationPerHour": 6,
    "MaxRequestsPerIpPerHour": 30,
    "ExposeSecretsInResponse": false,
    "SigningKey": "REPLACE_WITH_STRONG_64_CHAR_SECRET_KEY_DIFFERENT_FROM_JWT",
    "MagicLinkPath": "/auth/magic"
  },
  "Seed": {
    "Enabled": true,
    "DemoEmail": "demo@adventurepacks.com",
    "DemoPassword": "Adventure123!",
    "CreatePremiumDemoUser": true,
    "PremiumDemoEmail": "premium@adventurepacks.com"
  },
  "Stripe": {
    "Enabled": true,
    "SecretKey": "sk_test_REPLACE_WITH_STRIPE_SECRET_KEY",
    "PublishableKey": "pk_test_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET",
    "DigitalPriceId": "price_REPLACE_WITH_GEL_PRICE_ID_14_GEL_DIGITAL",
    "PrintPriceId": "price_REPLACE_WITH_GEL_PRICE_ID_79_GEL_PRINT_PLUS_DIGITAL",
    "PrintUpgradePriceId": "price_REPLACE_WITH_GEL_PRICE_ID_65_GEL_PRINT_UPGRADE",
    "SiteBaseUrl": "https://YOUR-FRONTEND.azurewebsites.net",
    "SuccessPath": "/create",
    "CancelPath": "/create",
    "EnableWallets": true,
    "AllowAdHocAmounts": true,
    "SessionExpiryMinutes": 60
  },
  "Recaptcha": {
    "Enabled": true,
    "SiteKey": "REPLACE_WITH_RECAPTCHA_V2_SITE_KEY",
    "SecretKey": "REPLACE_WITH_RECAPTCHA_V2_SECRET_KEY",
    "MinimumScore": 0.5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*"
