{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:adventuresapi-server.database.windows.net,1433;Initial Catalog=adventuresapi-database;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Issuer": "AdventurePacks.Api",
    "Audience": "AdventurePacks.Client",
    "SecretKey": "REPLACE_WITH_STRONG_64_CHAR_SECRET_KEY",
    "ExpirationMinutes": 120
  },
  "OpenAI": {
    "ApiKey": "REPLACE_WITH_OPENAI_API_KEY",
    "Model": "gpt-4.1-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "ImageGenerationProvider": "responses",
    "ImageModel": "",
    "ImageSize": "1024x1024",
    "ImageQuality": "standard",
    "EnableStoryImages": true
  },
  "AzureBlobStorage": {
    "ConnectionString": "REPLACE_WITH_AZURE_STORAGE_CONNECTION_STRING",
    "ContainerName": "adventure-packs"
  },
  "Cors": {
    "AllowLocalhostFallback": false,
    "AllowedOrigins": [
      "https://YOUR-FRONTEND.azurewebsites.net",
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:8080"
    ]
  },
  "Seed": {
    "Enabled": true,
    "DemoEmail": "demo@adventurepacks.com",
    "DemoPassword": "Adventure123!",
    "CreatePremiumDemoUser": true,
    "PremiumDemoEmail": "premium@adventurepacks.com"
  },
  "Stripe": {
    "SecretKey": "REPLACE_WITH_STRIPE_SECRET_KEY",
    "PublishableKey": "REPLACE_WITH_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "REPLACE_WITH_STRIPE_WEBHOOK_SECRET",
    "PremiumPriceId": "REPLACE_WITH_PREMIUM_PRICE_ID",
    "SuccessUrl": "https://YOUR-FRONTEND.azurewebsites.net/billing/success",
    "CancelUrl": "https://YOUR-FRONTEND.azurewebsites.net/billing/cancel"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*"
}
