{
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowLocalhostFallback": true,
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "AdventurePacks.Api",
    "Audience": "AdventurePacks.Client",
    "SecretKey": "LOCAL-DEV-ONLY-replace-in-appsettings.Production.json-64chars!!",
    "ExpirationMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*"
}
