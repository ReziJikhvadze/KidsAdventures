  "cover": { "base_prompt_version": "cover-child-world-v1.3", "runtime_source": "Services/Story/Composite/CompositeIllustrationPrompt.cs" },
  "spread_rhythm": [
    {"page": 1, "text_side": "LEFT", "shot_instruction": "Use a wide establishing view. The environment is dominant and the child is relatively small within it."},
    {"page": 2, "text_side": "RIGHT", "shot_instruction": "Use a medium view for the first clear discovery. Make the child, the discovered subject, and their relationship immediately readable."},
    {"page": 3, "text_side": "LEFT", "shot_instruction": "Use a full-figure action view. Show the child's complete physical action clearly and keep hands readable."},
    {"page": 4, "text_side": "RIGHT", "shot_instruction": "Use a dramatic atmospheric wide view. Let the environmental change feel important while keeping the child emotionally readable."},
    {"page": 5, "text_side": "LEFT", "shot_instruction": "Use a wide travelling view. Show the child actively choosing or following the route through the environment."},
    {"page": 6, "text_side": "RIGHT", "shot_instruction": "Use a medium-wide major-reveal or problem-solving view. Keep the child's action and the obstacle/reveal legible in one frame."},
    {"page": 7, "text_side": "LEFT", "shot_instruction": "Use a close emotional view. Prioritize the child's face, the emotional exchange, and the story-relevant object, keeping every face and key object away from the middle of the canvas."},
    {"page": 8, "text_side": "RIGHT", "shot_instruction": "Use a cinematic wide continuation view. Resolve the current beat and keep a safe right-side text area with room for the continuation QR below it."}
  ],
  "image_generation": {
    "prompt_version": "child-world-image-v1.1",
