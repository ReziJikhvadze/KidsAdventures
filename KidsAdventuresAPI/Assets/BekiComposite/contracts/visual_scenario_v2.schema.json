{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beki.ge/schemas/visual-scenario-v2.json",
  "title": "BEKI Visual Scenario v2",
  "$comment": "v2.3 (P1-08): the narrative fields carry sentence guards. $defs/sentence is 'starts with a capital Latin or Georgian letter, four words or more, ends in terminal punctuation'; $defs/shortSentence is the same with a three-word floor, for beki_action. JSON Schema cannot say 'the value equals its own trim' — the leading-uppercase anchor refuses leading whitespace and the terminal-punctuation anchor refuses everything but a trailing newline, and VisualScenarioValidator's MALFORMED_TEXT check owns the exact-trim rule and the leading-conjunction rule. The fields are English by contract (the system instruction's GENERAL RULES: 'Write every output description in clear English'), so the Georgian ranges here are permissiveness, not an invitation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visual_lock",
    "cover",
    "spreads"
  ],
  "properties": {
    "visual_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_outfit",
        "recurring_elements"
      ],
      "properties": {
        "child_outfit": {
          "type": "string",
          "minLength": 1
        },
        "recurring_elements": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "front_child_world_scene",
        "beki_action",
        "back_environment"
      ],
      "properties": {
        "front_child_world_scene": {
          "$ref": "#/$defs/sentence"
        },
        "beki_action": {
          "$ref": "#/$defs/shortSentence"
        },
        "back_environment": {
          "$ref": "#/$defs/sentence"
        }
      }
    },
    "spreads": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "$ref": "#/$defs/spread1"
        },
        {
          "$ref": "#/$defs/spread2"
        },
        {
          "$ref": "#/$defs/spread3"
        },
        {
          "$ref": "#/$defs/spread4"
        },
        {
          "$ref": "#/$defs/spread5"
        },
        {
          "$ref": "#/$defs/spread6"
        },
        {
          "$ref": "#/$defs/spread7"
        },
        {
          "$ref": "#/$defs/spread8"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "sentence": {
      "$comment": "A complete sentence: no leading or trailing space, a capital Latin letter or a Georgian letter first, at least four whitespace-separated words, and . ! or ? last. The audited page-7 fragment ' sensitivity, the child gently pats...' fails on its leading space and its lowercase first letter.",
      "type": "string",
      "minLength": 16,
      "pattern": "^[A-Z\\u10A0-\\u10FF\\u1C90-\\u1CBF][^\\s]*(?:\\s+[^\\s]+){3,}[.!?]$"
    },
    "shortSentence": {
      "$comment": "The same rule with a three-word floor, for beki_action — one concise sentence that must still name Beki and a verb the pose table can read ('Beki listens attentively.').",
      "type": "string",
      "minLength": 12,
      "pattern": "^[A-Z\\u10A0-\\u10FF\\u1C90-\\u1CBF][^\\s]*(?:\\s+[^\\s]+){2,}[.!?]$"
    },
    "spreadBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "child_world_scene",
        "beki_action"
      ],
      "properties": {
        "page": {
          "type": "integer"
        },
        "child_world_scene": {
          "$ref": "#/$defs/sentence"
        },
        "beki_action": {
          "$ref": "#/$defs/shortSentence"
        },
        "props": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element",
              "state"
            ],
            "properties": {
              "element": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "NOT_FOUND",
                  "FOUND",
                  "CARRIED",
                  "PLACED",
                  "NO_LONGER_CARRIED",
                  "AMBIENT",
                  "ABSENT"
                ]
              }
            }
          }
        }
      }
    },
    "spread1": {
      "allOf": [
        {
          "$ref": "#/$defs/spreadBase"
        },
        {
          "properties": {
            "page": {
              "const": 1
            }
          }
        }
      ]
    },
    "spread2": {
      "allOf": [
        {
          "$ref": "#/$defs/spreadBase"
        },
        {
          "properties": {
            "page": {
              "const": 2
            }
          }
        }
      ]
    },
    "spread3": {
      "allOf": [
        {
          "$ref": "#/$defs/spreadBase"
        },
        {
          "properties": {
            "page": {
              "const": 3
            }
          }
        }
      ]
    },
    "spread4": {
      "allOf": [
        {
          "$ref": "#/$defs/spreadBase"
        },
        {
          "properties": {
            "page": {
              "const": 4
            }
          }
        }
      ]
    },
    "spread5": {
      "allOf": [
        {
          "$ref": "#/$defs/spreadBase"
        },
        {
          "properties": {
            "page": {
              "const": 5
            }
          }
        }
      ]
    },
    "spread6": {
      "allOf": [
        {
          "$ref": "#/$defs/spreadBase"
        },
        {
          "properties": {
            "page": {
              "const": 6
            }
          }
        }
      ]
    },
    "spread7": {
      "allOf": [
        {
          "$ref": "#/$defs/spreadBase"
        },
        {
          "properties": {
            "page": {
              "const": 7
            }
          }
        }
      ]
    },
    "spread8": {
      "allOf": [
        {
          "$ref": "#/$defs/spreadBase"
        },
        {
          "properties": {
            "page": {
              "const": 8
            }
          }
        }
      ]
    }
  }
}
