{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beki Page Scene Spec v1",
  "type": "object",
  "required": [
    "pageNumber",
    "charactersPresent",
    "childAction",
    "sceneSummaryEn",
    "composition"
  ],
  "properties": {
    "pageNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "charactersPresent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "childAction": {
      "type": "string"
    },
    "sceneSummaryEn": {
      "type": "string"
    },
    "mainEmotionalBeat": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "keyObject": {
      "type": "string"
    },
    "continuityState": {
      "type": "object"
    },
    "composition": {
      "type": "object",
      "required": [
        "shotType",
        "cameraAngle",
        "heroPlacement",
        "textSafeArea"
      ],
      "properties": {
        "shotType": {
          "type": "string"
        },
        "cameraAngle": {
          "type": "string"
        },
        "heroPlacement": {
          "type": "string"
        },
        "textSafeArea": {
          "type": "string"
        },
        "supportingPlacement": {
          "type": "string"
        },
        "focalObjectPlacement": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}